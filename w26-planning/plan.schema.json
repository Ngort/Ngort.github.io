{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "updatedAt": {
      "type": "string"
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "budget": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        "careExtras": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        "holidayDays": {
          "type": "number",
          "minimum": 0,
          "maximum": 90
        },
        "thankyou": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        "contingency": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "documents": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        "subsidy": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "care": {
          "type": "string",
          "enum": [
            "boarding",
            "visits",
            "friend"
          ]
        },
        "careConfirmed": {
          "type": "boolean"
        }
      },
      "required": [
        "budget",
        "careExtras",
        "holidayDays",
        "thankyou",
        "contingency",
        "documents",
        "subsidy",
        "care",
        "careConfirmed"
      ]
    },
    "answers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "priorities": {
          "type": "string",
          "maxLength": 20000
        },
        "work": {
          "type": "string",
          "maxLength": 20000
        },
        "confirmations": {
          "type": "string",
          "maxLength": 20000
        },
        "limits": {
          "type": "string",
          "maxLength": 20000
        }
      },
      "required": [
        "priorities",
        "work",
        "confirmations",
        "limits"
      ]
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "home",
              "roa-x",
              "roa-rail",
              "lon-x",
              "ber-x",
              "lon-n",
              "ber-n",
              "lon-f",
              "split",
              "both",
              "roa-n",
              "lon-both",
              "ber-both"
            ]
          },
          "start": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "end": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "transport": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 100000
            },
            "minItems": 2,
            "maxItems": 2
          },
          "daily": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 100000
            },
            "minItems": 2,
            "maxItems": 2
          },
          "extras": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 100000
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": [
          "id",
          "start",
          "end",
          "transport",
          "daily",
          "extras"
        ]
      },
      "minItems": 13,
      "maxItems": 13
    }
  },
  "required": [
    "schemaVersion",
    "updatedAt",
    "settings",
    "answers",
    "scenarios"
  ]
}